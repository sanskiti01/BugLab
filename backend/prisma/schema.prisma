generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int               @id @default(autoincrement())
  username         String            @unique
  email            String            @unique
  passwordHash     String?
  githubId         String?           @unique
  avatarUrl        String?
  role             UserRole          @default(USER)
  xp               Int               @default(0)
  level            Int               @default(1)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  activities       Activity[]
  attempts         BugAttempt[]
  submissions      CodeSubmission[]
  githubConnection GitHubConnection?
  streak           Streak?
  achievements     UserAchievement[]
}

model Bug {
  id          Int              @id @default(autoincrement())
  title       String
  description String
  starterCode String?
  difficulty  Difficulty       @default(EASY)
  language    String
  topic       String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  attempts    BugAttempt[]
  testCases   BugTestCase[]
  submissions CodeSubmission[]
}

model BugAttempt {
  id                Int           @id @default(autoincrement())
  userId            Int
  bugId             Int
  submittedSolution String?
  status            AttemptStatus @default(FAILED)
  hintsUsed         Int           @default(0)
  timeSpent         Int           @default(0)
  createdAt         DateTime      @default(now())
  bug               Bug           @relation(fields: [bugId], references: [id])
  user              User          @relation(fields: [userId], references: [id])

  @@index([userId])
}

model CodeSubmission {
  id                 String           @id @default(uuid()) @db.Uuid
  userId             Int
  bugId              Int
  status             SubmissionStatus @default(QUEUED)
  idempotencyKey     String
  requestHash        String
  submittedSolution  String?
  hintsUsed          Int              @default(0)
  timeSpent          Int              @default(0)
  testCaseIds        Int[]
  totalTestCases     Int              @default(0)
  completedTestCases Int              @default(0)
  results            Json             @default("[]")
  solved             Boolean?
  xpAwarded          Int              @default(0)
  alreadySolved      Boolean          @default(false)
  attemptCount       Int              @default(0)
  workerId           String?
  leaseToken         String?          @db.Uuid
  leaseUntil         DateTime?
  failureCode        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  startedAt          DateTime?
  finishedAt         DateTime?
  bug                Bug              @relation(fields: [bugId], references: [id])
  user               User             @relation(fields: [userId], references: [id])

  @@unique([userId, idempotencyKey])
  @@index([status, createdAt])
  @@index([status, leaseUntil])
  @@index([userId, createdAt])
}

model BugTestCase {
  id             Int     @id @default(autoincrement())
  bugId          Int
  input          String
  expectedOutput String
  isHidden       Boolean @default(false)
  bug            Bug     @relation(fields: [bugId], references: [id])

  @@index([bugId])
}

model Activity {
  id     Int      @id @default(autoincrement())
  userId Int
  date   DateTime
  solved Int      @default(0)
  user   User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([userId, date])
}

model Streak {
  id           Int       @id @default(autoincrement())
  userId       Int       @unique
  current      Int       @default(0)
  longest      Int       @default(0)
  lastSolvedAt DateTime?
  user         User      @relation(fields: [userId], references: [id])
}

model Achievement {
  id          Int               @id @default(autoincrement())
  name        String            @unique
  description String
  icon        String?
  xpReward    Int               @default(0)
  createdAt   DateTime          @default(now())
  users       UserAchievement[]
}

model UserAchievement {
  id            Int         @id @default(autoincrement())
  userId        Int
  achievementId Int
  earnedAt      DateTime    @default(now())
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@unique([userId, achievementId])
}

model GitHubConnection {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  githubId    String
  username    String
  accessToken String
  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

enum UserRole {
  USER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  BOSS
}

enum AttemptStatus {
  FAILED
  PASSED
}

enum SubmissionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}
